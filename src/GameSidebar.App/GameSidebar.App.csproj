<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <AssemblyName>ArkSide</AssemblyName>
    <Product>ArkSide</Product>
    <Title>ArkSide</Title>
    <ApplicationIcon>../../assets/ArkSide.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArkSideProduction)' == 'true'">
    <DefineConstants>$(DefineConstants);ARKSIDE_PRODUCTION</DefineConstants>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(ArkSideProduction)' == 'true'">
    <Compile Remove="Views/OperatorImportWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../ArkSide.png" LogicalName="ArkSide.Icon.png" />
    <ProjectReference Include="../GameSidebar.Application/GameSidebar.Application.csproj" />
    <ProjectReference Include="../GameSidebar.Platform.Windows/GameSidebar.Platform.Windows.csproj" />
    <ProjectReference Include="../GameSidebar.Platform.MacOS/GameSidebar.Platform.MacOS.csproj" />
    <ProjectReference Include="../GameSidebar.Infrastructure.Maa/GameSidebar.Infrastructure.Maa.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <Content Include="../../assets/profiles/*.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/target-game.example.json" Link="target-game.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../tools/offline_recognition/__init__.py;../../tools/offline_recognition/cli.py;../../tools/offline_recognition/domain.py;../../tools/offline_recognition/vision.py" Link="recognition/python/tools/offline_recognition/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../干员数据/干员详细信息.json;../../干员数据/干员禁用规则.json" Link="recognition/data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../干员数据/干员头像/*.png" Link="recognition/data/portraits/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(ArkSideProduction)' == 'true'">
    <Content Remove="../../tools/offline_recognition/*.py;../../assets/target-game.example.json" />
  </ItemGroup>
  <Target Name="BuildMacBridge" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <Exec Command="swiftc -O -parse-as-library -emit-library -o &quot;$(TargetDir)libGameSidebarMac.dylib&quot; &quot;$(MSBuildProjectDirectory)/../GameSidebar.Platform.MacOS/Native/GameSidebarMac.swift&quot; -framework AppKit -framework ScreenCaptureKit" />
  </Target>
  <Target Name="PublishMacBridge" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RuntimeIdentifier)' == 'osx-arm64'">
    <Exec Command="swiftc -O -parse-as-library -emit-library -o &quot;$(PublishDir)libGameSidebarMac.dylib&quot; &quot;$(MSBuildProjectDirectory)/../GameSidebar.Platform.MacOS/Native/GameSidebarMac.swift&quot; -framework AppKit -framework ScreenCaptureKit" />
  </Target>
</Project>
