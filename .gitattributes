* text=auto eol=lf

# Preserve Windows-native line endings for batch scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common generated or media assets as binary if they are added later.
*.7z binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.zip binary
